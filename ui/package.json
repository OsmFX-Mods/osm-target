{
  "name": "osm-target-ui",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:design": "node ../scripts/build-design.mjs",
    "build:designs": "node ../scripts/build-design.mjs --all",
    "build:all": "npm run build && npm run build:designs",
    "verify": "node ../scripts/verify-packs.mjs",
    "pack": "node ../scripts/pack-design.mjs",
    "pack:built": "node ../scripts/pack-design.mjs --built",
    "pack:source": "node ../scripts/pack-design.mjs --source",
    "pack:all-tiers": "node ../scripts/pack-design.mjs --both",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
